{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "today",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // No routes and no workers.dev: today is reachable only through the Common
  // Auth gateway's TODAY service binding. The zone route today.lost.plus/*
  // belongs to auth-gateway (LPFchan/auth, gateway/config/cloudflare.gateway.json).
  // A route here would open a second entrance where nothing strips a caller's
  // own x-lost-plus-* headers.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    // /everyone is the same page as /; the app picks the view from the path.
    "not_found_handling": "single-page-application",
    // The API, the pairing mailbox and the Mac download redirect are code;
    // everything else is a file.
    "run_worker_first": ["/api/*", "/pair", "/pair/*", "/download/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "today",
      "database_id": "d2a249d1-d184-4016-a74a-8c35f810338f",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
